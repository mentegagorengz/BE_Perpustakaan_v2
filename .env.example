DB_HOST=localhost
DB_PORT=5432
DB_USER=perpustakaan
DB_PASSWORD=change_me
DB_NAME=perpustakaan

# Set true hanya untuk development lokal (TypeORM auto-buat tabel dari entity).
# JANGAN true di production — pakai migration.
DB_SYNC=false

# JWT — ganti dengan string acak yang panjang di production.
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d

# CORS — daftar origin frontend yang diizinkan, dipisah koma.
# Kosongkan hanya untuk development lokal (mengizinkan semua origin).
# Contoh: CORS_ORIGIN=https://app.perpustakaan.com,https://admin.perpustakaan.com
CORS_ORIGIN=
